{
  // Configuração do deploy no Cloudflare.
  //
  // O site inteiro fica em public/. Isso é deliberado: a pasta publicada
  // não contém .git, tests nem documentação, então não existe como
  // vazá-los por engano — que foi o que aconteceu no primeiro deploy,
  // quando a pasta publicada era a raiz do repositório.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bucks-burger",
  "compatibility_date": "2026-09-16",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  }
}
